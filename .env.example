# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/namecard

# Auth
JWT_SECRET=your-32-char-secret-change-this-in-production

# LLM Provider: "alibaba" | "claude"
LLM_PROVIDER=claude

# Alibaba Cloud Dashscope (OpenAI-compatible API)
# Singapore International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China Mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=
ALIBABA_MODEL=qwen3.7-max

# Anthropic Claude
# Official API: https://api.anthropic.com
# Can also be configured to use a proxy URL
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4.6

# Storage: "local" | "vercel" | "aliyun-oss"
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# Aliyun OSS (when STORAGE_PROVIDER=aliyun-oss)
# RAM user credentials for STS AssumeRole
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# RAM Role ARN (the role with OSS read/write permissions)
ALIYUN_OSS_ROLE_ARN=
# OSS bucket region (e.g., oss-ap-southeast-1, oss-cn-hangzhou)
ALIYUN_OSS_REGION=
# OSS bucket name
ALIYUN_OSS_BUCKET=
# STS endpoint (optional, defaults to https://sts.aliyuncs.com)
# China Mainland: https://sts.cn-hangzhou.aliyuncs.com
# International: https://sts.aliyuncs.com
ALIYUN_OSS_STS_ENDPOINT=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
