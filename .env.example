# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/namecard

# Auth
JWT_SECRET=your-32-char-secret-change-this-in-production

# LLM Provider: "alibaba" | "claude"
LLM_PROVIDER=claude

# Alibaba Cloud Dashscope (OpenAI-compatible API)
# Singapore International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China Mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=
ALIBABA_MODEL=qwen3.7-max

# Anthropic Claude
# Official API: https://api.anthropic.com
# Can also be configured to use a proxy URL
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4.6

# Storage: "local" | "vercel"
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
